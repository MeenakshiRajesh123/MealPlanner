<?xml version="1.0" encoding="utf-8"?>
<!--/*COMP3450: Calvin Thomschke, Jaxon Isnardy, and Meenakshi Rajesh*/-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/background"
    android:layout_height="match_parent"
    tools:context=".navMenu">

    <TextView
        android:id="@+id/navTitle"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:background="@color/header"
        android:gravity="center"
        android:text="Navigation"
        android:textColor="@color/white"
        android:textSize="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/returnButton"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/returnButton"
        android:layout_width="71dp"
        android:layout_height="71dp"
        android:background="@color/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_media_previous" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="658dp"
        android:layout_marginTop="1dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/navTitle">

        <Button
            android:id="@+id/recipebutton"
            android:layout_width="330dp"
            android:layout_height="80dp"
            android:backgroundTint="@color/list"
            android:text="Cook Book"
            android:textSize="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/recipeicon"
            app:layout_constraintTop_toBottomOf="@id/grocerybutton" />

        <ImageView
            android:id="@+id/weekplanicon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login"
            app:srcCompat="@android:drawable/ic_menu_my_calendar" />

        <Button
            android:id="@+id/weekplanbutton"
            android:layout_width="330dp"
            android:layout_height="80dp"
            android:text="Week Plan"
            android:textSize="20dp"
            android:backgroundTint="@color/list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/weekplanicon"
            app:layout_constraintTop_toBottomOf="@id/login" />
        <ImageView
            android:id="@+id/favoritesicon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weekplanicon"
            app:srcCompat="@android:drawable/btn_star_big_off" />

        <Button
            android:id="@+id/favoritebutton"
            android:layout_width="330dp"
            android:layout_height="80dp"
            android:text="Favorites"
            android:textSize="20dp"
            android:backgroundTint="@color/list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/favoritesicon"
            app:layout_constraintTop_toBottomOf="@id/weekplanbutton" />

        <ImageView
            android:id="@+id/groceryicon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/favoritesicon"
            app:srcCompat="@android:drawable/ic_menu_info_details" />

        <Button
            android:id="@+id/grocerybutton"
            android:layout_width="330dp"
            android:layout_height="80dp"
            android:text="Shopping List"
            android:textSize="20dp"
            android:backgroundTint="@color/list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/groceryicon"
            app:layout_constraintTop_toBottomOf="@id/favoritebutton" />

        <ImageView
            android:id="@+id/recipeicon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/groceryicon"
            app:srcCompat="@android:drawable/ic_dialog_dialer" />

        <Button
            android:id="@+id/login"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:backgroundTint="@color/list"
            android:text="Log In"
            android:textSize="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/SignUp"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/list"
            android:text="Sign Up"
            android:textSize="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/editTextUsername"
            android:layout_width="360dp"
            android:layout_height="60dp"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="@color/list"
            android:gravity="center"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="36dp"
            android:textStyle="bold"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/signoutButton"
            android:layout_width="330dp"
            android:layout_height="80dp"
            android:layout_marginBottom="96dp"
            android:backgroundTint="@color/list"
            android:text="Sign Out"
            android:textSize="20dp"
            app:layout_constraintStart_toEndOf="@+id/signoutIcon"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:layout_editor_absoluteX="142dp" />

        <ImageView
            android:id="@+id/signoutIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="82dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/signoutButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recipeicon"
            app:srcCompat="@drawable/exit"
            app:tint="#ccc" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>